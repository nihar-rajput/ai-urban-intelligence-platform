# ==============================================================================
# AI Urban Intelligence Platform - Environment Configuration
# ==============================================================================

# Backend API Configuration
PROJECT_NAME="AI Urban Intelligence Platform"
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (SQLite default with clean PostgreSQL/PostGIS path)
DATABASE_URL="sqlite+aiosqlite:///./urban_intelligence.db"
# Example PostgreSQL / PostGIS URL for production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/urban_intelligence"

# Computer Vision & Inference Configuration
DEVICE="cuda" # "cuda" or "cpu"
DETECTION_CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
MAX_DETECTION_BATCH_SIZE=4

# Model Weights Paths
YOLO_VEHICLE_MODEL="models/yolov8n.pt"
YOLO_ROAD_DEFECT_MODEL="models/road_defects_best.pt"
ENABLE_FALLBACK_SIMULATION=False

# Storage & Evidence
STORAGE_DIR="evidence"
SAMPLE_VIDEOS_DIR="sample_videos"
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=["mp4","avi","mov","mkv"]

# Fleet & Telemetry Simulation
BUS_DEFAULT_ROUTES=["BUS-001","BUS-002","BUS-003"]
ENABLE_DEMO_TELEMETRY=True
DEMO_TELEMETRY_LAT=28.6139
DEMO_TELEMETRY_LON=77.2090

# Frontend Configuration (for Vite)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_WS_BASE_URL="ws://127.0.0.1:8000/api/v1/ws"
